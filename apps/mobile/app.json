{
  "expo": {
    "name": "Heartspirit",
    "slug": "heartspirit",
    "backgroundColor": "#0a1410",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.raised-vibes.heartspirit",
      "buildNumber": "2",
      "splash": {
        "backgroundColor": "#0a1410",
        "resizeMode": "cover",
        "image": "./assets/images/heartspirit_intro.png",
        "dark": {
          "backgroundColor": "#0a1410"
        }
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a1410"
      },
      "splash": {
        "backgroundColor": "#0a1410",
        "resizeMode": "cover",
        "image": "./assets/images/heartspirit_intro.png",
        "dark": {
          "backgroundColor": "#0a1410"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.raised_vibes.heartspirit",
"googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "sounds": [
            "./assets/audio/heartspirit_chime.mp3"
          ],
          "defaultChannel": "default"
        }
      ],
      "./plugins/withAndroidFullBleedSplash",
      "./plugins/withAndroidFullBleedSplashStyles",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/heartspirit_intro.png",
            "resizeMode": "cover",
            "backgroundColor": "#0a1410",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "backgroundColor": "#0a1410"
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79e04053-4a59-476b-a26a-b58994bf9a45"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79e04053-4a59-476b-a26a-b58994bf9a45"
    }
  }
}
